{
    "name": "axelferdinand/statamic-secretary-relay",
    "description": "Hosted routing service for the optional shared Statamic Secretary address.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*",
        "ext-sodium": "*"
    },
    "autoload": {
        "psr-4": {
            "AxelFerdinand\\StatamicSecretaryRelay\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
